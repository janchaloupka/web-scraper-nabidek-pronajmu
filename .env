DEBUG=0
FOUND_OFFERS_FILE=found_offers.txt
REFRESH_INTERVAL_DAYTIME_MINUTES=30
REFRESH_INTERVAL_NIGHTTIME_MINUTES=90
DISCORD_TOKEN=CREATE_ENV_LOCAL_AND_SET_TOKEN
DISCORD_OFFERS_CHANNEL=1067564052022300672
DISCORD_DEV_CHANNEL=954732715377311825
DISPOSITIONS=3+kk,3+1
# Comma-separated list of scrapers to use. Available: bravis,eurobydleni,idnesreality,realcity,realingo,remax,sreality,ulovdomov,bezrealitky,bazos
# (realingo is temporarily not working and is disabled by default)
SCRAPERS=bravis,eurobydleni,idnesreality,realcity,remax,sreality,ulovdomov,bezrealitky,bazos

# In case you want to use Bazos.cz portal, fill in at least one of the BAZOS_* search parameters below
# (typically BAZOS_SEARCHSTRING). If none of them is set, the Bazos scraper is skipped.
# BAZOS_GROUP selects the Bazos category (subdomain), e.g. reality, auto, dum, elektro, ... or www for all categories
BAZOS_GROUP=reality
BAZOS_SEARCHSTRING=
BAZOS_LOCATION=
BAZOS_RADIUS=
BAZOS_PRICE_FROM=
BAZOS_PRICE_TO=
